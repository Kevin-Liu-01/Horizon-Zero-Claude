{
  "version": 1,
  "set": "M1",
  "about": "The Frame Set F01-F32: fixed camera, hour, weather and state per frame, and what each is compared against. Reference crops are named by id only; the masked images live outside the repo (tools/frames/paths.mjs). Read by tools/frames/film.mjs and tools/frames/review.mjs; validated by tools/frames/frameset.mjs.",
  "viewport": { "width": 1600, "height": 900, "dpr": 1.25 },
  "conventions": {
    "at": "look.<name> (ctx.props.gatePlaces.look row) | place:<name> (ctx.props.gatePlaces row) | site:<id> | trig:<id> | rest | fire | {\"en\": [E, N]} in bible metres (x = E, z = -N, times ISLAND_SCALE)",
    "approach": "{ dist, bearing }: stand Brea dist metres from 'at' along the compass bearing, facing back toward it",
    "bearing": "compass degrees, 0 = north, 90 = east; Brea faces it unless 'approach' sets her facing",
    "camera.chase": "the game's own chase camera behind Brea; pitch in degrees",
    "camera.eye": "a fixed lens at eye metres over the ground at 'at', looking along bearing/pitch; Brea hidden unless hideHero is false",
    "camera.pov": "a lens at Brea's eye height on her position, looking along her facing; Brea hidden",
    "camera.orbit": "a lens around Brea: yawRel degrees from her front (+ toward her left), dist metres, height metres over her feet, target 'body' | 'head' | {fwd, up} metres in her frame",
    "camera.screen": "a full-screen UI state: title | map | crafting | character | sighting",
    "state.pose": "idle | run | draw | crouch | crouchAim | lanceHeavy | sit",
    "state.actors": "people by archetype id and Instruments by kind, placed dist metres from Brea at side degrees (+ her left), facing Brea or the camera",
    "ref": "crops: masked reference crop ids, first is primary | text: a worded reference id | written: a countable target | measured: rows the filmer reads | bar: an animation bar measured as rows"
  },
  "frames": [
