-/* ------------------------------------------------------------ geometry utils */
-function bbox(parts) {
-  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
-  const add = (x, y, pad = 0) => { x0 = Math.min(x0, x - pad); x1 = Math.max(x1, x + pad); y0 = Math.min(y0, y - pad); y1 = Math.max(y1, y + pad); };
-  for (const p of parts) {
-    if (p.t === 'rect' || p.t === 'frame') { add(p.x, p.y); add(p.x + p.w, p.y + p.h); }
-    else if (p.t === 'ell') { add(p.cx - p.rx, p.cy - p.ry); add(p.cx + p.rx, p.cy + p.ry); }
-    else if (p.t === 'circ') add(p.cx, p.cy, p.r);
-    else if (p.t === 'ring') add(p.cx, p.cy, p.r + p.w / 2);
-    else if (p.t === 'line') { add(p.x1, p.y1, p.w / 2); add(p.x2, p.y2, p.w / 2); }
-    else if (p.t === 'poly') for (const [x, y] of p.p) add(x, y);
-  }
-  return { x0, y0: Math.min(0, y0), x1, y1, w: x1 - x0, h: y1 - Math.min(0, y0) };
-}
-
-const fillOf = (p, mode) => {
-  if (mode === 'mask') return '#000';
-  if (!p.c) return PAL.ink;
-  if (p.c === 'rod' || p.c === 'tether') return 'url(#band)';
-  if (p.c === 'braid' || p.c === 'flag') return PAL.terracotta;
-  if (p.c === 'tool') return mode === 'read100' ? PAL.ink : PAL.tool;
-  return PAL[p.c];
-};
-
-function shapes(parts, X, Y, s, mode) {
-  // X(x), Y(y) map metres to px; s = px per metre
-  let out = '';
-  // draw body first, coded parts last so lamps sit on top
-  const sorted = [...parts].sort((a, b) => (a.c ? 1 : 0) - (b.c ? 1 : 0));
-  for (const p of sorted) {
-    const f = fillOf(p, mode);
-    if (p.t === 'rect') out += `<rect x="${X(p.x)}" y="${Y(p.y + p.h)}" width="${p.w * s}" height="${p.h * s}" rx="${(p.r || 0) * s}" fill="${f}"/>`;
-    else if (p.t === 'frame') out += `<rect x="${X(p.x)}" y="${Y(p.y + p.h)}" width="${p.w * s}" height="${p.h * s}" fill="none" stroke="${f}" stroke-width="${p.s * s}"/>`;
-    else if (p.t === 'ell') out += `<ellipse cx="${X(p.cx)}" cy="${Y(p.cy)}" rx="${p.rx * s}" ry="${p.ry * s}" fill="${f}"/>`;
-    else if (p.t === 'circ') out += `<circle cx="${X(p.cx)}" cy="${Y(p.cy)}" r="${p.r * s}" fill="${f}"/>`;
-    else if (p.t === 'ring') out += `<circle cx="${X(p.cx)}" cy="${Y(p.cy)}" r="${p.r * s}" fill="none" stroke="${f}" stroke-width="${p.w * s}"/>`;
-    else if (p.t === 'line') out += `<line x1="${X(p.x1)}" y1="${Y(p.y1)}" x2="${X(p.x2)}" y2="${Y(p.y2)}" stroke="${f}" stroke-width="${Math.max(p.w * s, mode === 'mask' ? 0 : 0.6)}" stroke-linecap="round"/>`;
-    else if (p.t === 'poly') out += `<polygon points="${p.p.map(([x, y]) => `${X(x)},${Y(y)}`).join(' ')}" fill="${f}"/>`;
-  }
-  return out;
-}
-
-const DEFS = `<defs><pattern id="band" patternUnits="userSpaceOnUse" width="8" height="8" patternTransform="rotate(30)">
-<rect width="4" height="8" fill="${PAL.hostile}"/><rect x="4" width="4" height="8" fill="#EFE9DC"/></pattern></defs>`;
-
-/* ------------------------------------------------------------ roster sheet */
-const pxPerM = (d) => 900 / (2 * d * Math.tan((55 / 2) * Math.PI / 180));
-const S40 = pxPerM(40), S100 = pxPerM(100);
-
-function row(scale, mode, top, baseline, label) {
-  let x = 40, svg = '', labels = '';
-  const gap = 1.6;
-  const place = (name, parts, sub) => {
-    const b = bbox(parts);
-    const slot = Math.max(b.w * scale, sub ? 112 : 64);
-    const off = (slot - b.w * scale) / 2;
-    const X = (mx) => (x + off + (mx - b.x0) * scale).toFixed(2);
-    const Y = (my) => (baseline - my * scale).toFixed(2);
-    svg += shapes(parts, X, Y, scale, mode);
-    if (label) {
-      const cx = x + slot / 2;
-      labels += `<text x="${cx}" y="${baseline + 22}" font-family="Rajdhani" font-weight="600" font-size="17" fill="${PAL.ink}" text-anchor="middle">${name}</text>`;
-      if (sub) labels += `<text x="${cx}" y="${baseline + 40}" font-family="Rajdhani" font-weight="500" font-size="13" fill="#4A5058" text-anchor="middle">${sub}</text>`;
-    }
-    x += slot + gap * scale;
-  };
-  place('Isa', HUMAN, label === 'full' ? '1.72 m' : '');
