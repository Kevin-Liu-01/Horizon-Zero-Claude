    { "class": "ctx member", "from": "player.pouch / player.medicine", "to": "player.gourd / player.gourdDoses", "re": "\\bplayer\\??\\.(?:pouch|maxPouch|addPouch|medicine)\\b", "flags": "g" },
    { "class": "ctx member", "from": "player.pouch (receivers audited to be the player)", "to": "player.gourd", "re": "\\b(?:p|this|ctx\\.player|this\\.ctx\\.player)\\??\\.(?:pouch|maxPouch|addPouch)\\b|\\bget medicine\\(|^\\s*addPouch\\(", "flags": "gm", "files": ["src/entities/player.js", "src/ui/inventory.js", "src/ui/hud.js", "src/core/progression.js", "src/core/save.js", "src/world/camp.js", "src/items/tools.js", "src/items/gather.js"] },
    { "class": "asset rig row", "from": "assets.models.aloy", "to": "assets.models.hero", "re": "\\bmodels\\??\\.aloy\\w*\\b|models\\[['\"]aloy['\"]\\]|^\\s*aloy:\\s+\\{ url:", "flags": "gm" }
