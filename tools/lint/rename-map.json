    { "class": "storage key", "from": "hzc.meta.v4", "to": "cal.meta.v5", "re": "hzc\\.meta\\.v4", "flags": "g" },
    { "class": "storage key", "from": "hzc.settings.v1", "to": "cal.settings.v5", "re": "hzc\\.settings\\.v1", "flags": "g" },
