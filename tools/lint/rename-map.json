    { "class": "event", "from": "datapoint-found", "to": "fieldbook-found", "re": "(?<![\\w-])datapoint-found(?![\\w-])", "flags": "g" },
    { "class": "event", "from": "supply-cache", "to": "cache-found", "re": "(?<![\\w-])supply-cache(?![\\w-])", "flags": "g" },
    { "class": "event", "from": "silent-strike", "to": "undercut", "re": "(?<![\\w-])silent-strike(?![\\w-])", "flags": "g" },
    { "class": "event", "from": "focus-on", "to": "sighting-on", "re": "(?<![\\w-])focus-on(?![\\w-])", "flags": "g" },
    { "class": "event", "from": "focus-off", "to": "sighting-off", "re": "(?<![\\w-])focus-off(?![\\w-])", "flags": "g" },
    { "class": "event", "from": "focus-pulse", "to": "sighting-pulse", "re": "(?<![\\w-])focus-pulse(?![\\w-])", "flags": "g" },
    { "class": "event", "from": "concentration-start", "to": "steady-start", "re": "(?<![\\w-])concentration-start(?![\\w-])", "flags": "g" },
    { "class": "event", "from": "concentration-end", "to": "steady-end", "re": "(?<![\\w-])concentration-end(?![\\w-])", "flags": "g" },
    { "class": "event", "from": "machine-tied", "to": "instrument-fouled", "re": "(?<![\\w-])machine-tied(?![\\w-])", "flags": "g" },
    { "class": "event", "from": "rope-attached", "to": "net-fouled", "re": "(?<![\\w-])rope-attached(?![\\w-])", "flags": "g" },
